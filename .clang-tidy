# .clang-tidy: the checks clang-tidy runs on this project (picked up automatically
# by clang-tidy and by Visual Studio's Code Analysis). Same list as the
# 2026-10-15 analysis sweep. See MyNotes/analysis-2026-10-15.md.
Checks: '-*,bugprone-*,-bugprone-easily-swappable-parameters,clang-analyzer-*,performance-*,misc-*,-misc-include-cleaner,-misc-non-private-member-variables-in-classes,-misc-use-anonymous-namespace,-misc-use-internal-linkage,modernize-use-nullptr,modernize-use-override,modernize-use-equals-default,cppcoreguidelines-pro-type-member-init,cppcoreguidelines-narrowing-conversions,cppcoreguidelines-special-member-functions,cppcoreguidelines-init-variables,cppcoreguidelines-virtual-class-destructor,readability-inconsistent-declaration-parameter-name,readability-make-member-function-const,readability-convert-member-functions-to-static,readability-redundant-*,readability-container-size-empty,readability-else-after-return,readability-non-const-parameter'
# Report problems in our own headers (src/...), not in GLFW's or Vulkan's.
HeaderFilterRegex: '.*simpleVulkanRenderer.src.*'
WarningsAsErrors: ''
